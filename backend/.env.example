# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET=changeme-super-secret-key

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=automata_tg

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_SUPPORT_USERNAME=automata_support
TELEGRAM_ANNOUNCE_CHANNEL=https://t.me/automata_tg

# ─── Google Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# ─── Social links (JSON string) ───────────────────────────────────────────────
SOCIAL_TWITTER=https://twitter.com/automatatg
SOCIAL_INSTAGRAM=https://instagram.com/automatatg
SOCIAL_TIKTOK=https://tiktok.com/@automatatg
SOCIAL_WEBSITE=https://automatatg.com

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
